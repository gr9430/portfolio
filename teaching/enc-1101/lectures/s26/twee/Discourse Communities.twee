:: StoryScript [script]
/* =============================================
   ENC 1101 TIMER SYSTEM — JAVASCRIPT
   Paste into: Story → Story JavaScript
   ============================================= */
(function () {
  'use strict';

  /* ---- State ---- */
  var timerState = {};       /* passageName → endTimestamp (ms) */
  var completedState = {};   /* passageName → true */
  var intervalId = null;
  var activePassage = null;  /* passage currently being timed */
  var overrideClicks = 0;
  var overrideTimeout = null;
  var scanning = false;      /* re-entry guard */

  /* ---- Timer UI ---- */
  var timerEl = document.createElement('div');
  timerEl.className = 'enc-timer';
  timerEl.innerHTML =
    '<span class="timer-label">Time Remaining</span>' +
    '<span class="timer-display">--:--</span>';
  document.body.appendChild(timerEl);

  var labelEl = timerEl.querySelector('.timer-label');
  var displayEl = timerEl.querySelector('.timer-display');

  /* ---- Helpers ---- */
  function fmt(secs) {
    var m = Math.floor(secs / 60);
    var s = secs % 60;
    return (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
  }

  function lockNav(container) {
    container.classList.add('locked');
    container.classList.remove('unlocked');
  }

  function unlockNav(container) {
    container.classList.remove('locked');
    container.classList.add('unlocked');
  }

  function unlockAll() {
    var els = document.querySelectorAll('.timed-nav');
    for (var i = 0; i < els.length; i++) {
      unlockNav(els[i]);
    }
  }

  /* ---- Audio Chime ---- */
  function playChime() {
    try {
      var ctx = new (window.AudioContext || window.webkitAudioContext)();
      var notes = [830, 1050];
      for (var i = 0; i < notes.length; i++) {
        var osc = ctx.createOscillator();
        var gain = ctx.createGain();
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.frequency.value = notes[i];
        osc.type = 'sine';
        var t = ctx.currentTime + i * 0.18;
        gain.gain.setValueAtTime(0.18, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.8);
        osc.start(t);
        osc.stop(t + 0.8);
      }
    } catch (e) { /* silent fail */ }
  }

  /* ---- Screen Flash ---- */
  function flashScreen() {
    var el = document.createElement('div');
    el.className = 'enc-timer-flash';
    document.body.appendChild(el);
    el.addEventListener('animationend', function () { el.remove(); });
  }

  /* ---- Stop Interval ---- */
  function stopInterval() {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
  }

  /* ---- Complete ---- */
  function onComplete(passageName) {
    stopInterval();
    completedState[passageName] = true;

    timerEl.className = 'enc-timer active complete';
    labelEl.textContent = "Time\u2019s Up";
    displayEl.textContent = '00:00';

    unlockAll();
    playChime();
    flashScreen();
  }

  /* ---- Show Completed State (no chime) ---- */
  function showCompleted() {
    timerEl.className = 'enc-timer active complete';
    labelEl.textContent = "Time\u2019s Up";
    displayEl.textContent = '00:00';
    unlockAll();
  }

  /* ---- Run Timer ---- */
  function runTimer(duration, passageName, navEl) {
    stopInterval();
    activePassage = passageName;

    /* Already done? Just show the result. */
    if (completedState[passageName]) {
      showCompleted();
      return;
    }

    /* End timestamp: resume existing or create new */
    var endTime;
    if (timerState[passageName] && timerState[passageName] > Date.now()) {
      endTime = timerState[passageName];
    } else {
      endTime = Date.now() + duration * 1000;
      timerState[passageName] = endTime;
    }

    /* Lock & show */
    lockNav(navEl);
    timerEl.className = 'enc-timer active';
    labelEl.textContent = 'Time Remaining';

    function tick() {
      var left = Math.max(0, Math.ceil((endTime - Date.now()) / 1000));

      displayEl.textContent = fmt(left);

      if (left <= 60 && left > 0) {
        timerEl.classList.add('warning');
      }

      if (left <= 0) {
        onComplete(passageName);
      }
    }

    tick();
    intervalId = setInterval(tick, 250);
  }

  /* ---- Scan Page for Timer ---- */
  function scan() {
    if (scanning) return;
    scanning = true;

    var navEl = document.querySelector('.timed-nav');

    if (!navEl) {
      /* No timed content on this page — hide timer, keep state */
      timerEl.className = 'enc-timer';
      activePassage = null;
      scanning = false;
      return;
    }

    var duration = parseInt(navEl.getAttribute('data-timer'), 10);
    var passage = navEl.getAttribute('data-passage');

    if (!duration || !passage) {
      scanning = false;
      return;
    }

    /* Same passage we're already timing? Don't restart. */
    if (passage === activePassage && intervalId) {
      scanning = false;
      return;
    }

    runTimer(duration, passage, navEl);
    scanning = false;
  }

  /* ---- Instructor Override: Triple-click ---- */
  timerEl.addEventListener('click', function () {
    overrideClicks++;
    clearTimeout(overrideTimeout);
    overrideTimeout = setTimeout(function () { overrideClicks = 0; }, 800);

    if (overrideClicks >= 3) {
      overrideClicks = 0;
      stopInterval();

      if (activePassage) {
        completedState[activePassage] = true;
      }

      timerEl.className = 'enc-timer active complete';
      labelEl.textContent = 'Override';
      displayEl.textContent = '\u2713';
      unlockAll();
    }
  });

  /* ---- Watch for Passage Changes ---- */
  var debounce = null;

  var observer = new MutationObserver(function () {
    clearTimeout(debounce);
    debounce = setTimeout(scan, 200);
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true,
    attributes: false,
    characterData: false
  });

  /* Initial scan */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scan);
  } else {
    scan();
  }

})();

:: StoryStylesheet [stylesheet]
/* =============================================
   ENC 1101 — STORY STYLESHEET
   Paste into: Story → Story Stylesheet
   ============================================= */


/* =============================================
   SECTION 1: RESPONSIVE LAYOUT
   ============================================= */

/* --- Base: fit content to viewport --- */
article[role="main"],
.body.content,
#page article,
.passage {
  max-width: 90vw;
  width: 100%;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 5rem 1.5rem; /* bottom padding clears timer */
  box-sizing: border-box;
  overflow-wrap: break-word;
  word-wrap: break-word;
}

/* --- Typography --- */
body {
  font-size: 14px;
  line-height: 1.55;
}

h1 {
  font-size: 1.7em;
  line-height: 1.2;
  margin-top: 0.8em;
}

h2 {
  font-size: 1.4em;
  line-height: 1.25;
  margin-top: 0.8em;
}

h3 {
  font-size: 1.15em;
  line-height: 1.3;
}

/* --- Links: larger tap targets on touch --- */
a {
  display: inline-block;
  padding: 0.15em 0;
}

/* --- Lists: prevent overflow --- */
ul, ol {
  padding-left: 1.5em;
}

li {
  margin-bottom: 0.4em;
}

/* --- Horizontal rules --- */
hr {
  margin: 1.2em 0;
}

/* --- Desktop: cap width for readability --- */
@media (min-width: 769px) {
  article[role="main"],
  .body.content,
  #page article,
  .passage {
    max-width: 700px;
    padding-bottom: 4rem;
  }
}

/* --- Tablet --- */
@media (min-width: 481px) and (max-width: 768px) {
  article[role="main"],
  .body.content,
  #page article,
  .passage {
    max-width: 92vw;
    padding: 1.2rem 1.2rem 5rem 1.2rem;
  }
}

/* --- Mobile --- */
@media (max-width: 480px) {
  article[role="main"],
  .body.content,
  #page article,
  .passage {
    max-width: 100vw;
    padding: 1rem 1rem 6rem 1rem; /* extra bottom for timer */
  }

  h1 { margin-top: 0.5em; }

  /* Bigger tap targets for links */
  a {
    padding: 0.35em 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
}


/* =============================================
   SECTION 2: TIMER SYSTEM
   ============================================= */

/* --- Timer Display (bottom-right) --- */
.enc-timer {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #1a1a2e;
  color: #e0e0e0;
  padding: 12px 20px;
  border-radius: 8px;
  font-family: 'Courier New', monospace;
  font-weight: bold;
  z-index: 1000;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  cursor: default;
  user-select: none;
  transition: background 0.5s, color 0.5s, box-shadow 0.5s;
  display: none;
  text-align: center;
  min-width: 100px;
}

.enc-timer.active {
  display: block;
}

.enc-timer .timer-label {
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  opacity: 0.7;
  display: block;
  margin-bottom: 4px;
}

.enc-timer .timer-display {
  font-size: 1.6rem;
  display: block;
}

/* --- Timer: Mobile --- */
@media (max-width: 480px) {
  .enc-timer {
    bottom: 12px;
    right: 12px;
    padding: 10px 14px;
    min-width: 80px;
  }

  .enc-timer .timer-display {
    font-size: 1.3rem;
  }

  .enc-timer .timer-label {
    font-size: 0.55rem;
  }
}

/* --- Timer States --- */
.enc-timer.warning {
  color: #fbbf24;
}

.enc-timer.complete {
  background: #0d4d2b;
  color: #4ade80;
  box-shadow: 0 2px 20px rgba(74, 222, 128, 0.4);
  animation: timer-pulse 1.5s ease-in-out 3;
}

.enc-timer.complete .timer-label {
  opacity: 1;
}

@keyframes timer-pulse {
  0%, 100% { box-shadow: 0 2px 12px rgba(74, 222, 128, 0.2); }
  50% { box-shadow: 0 2px 24px rgba(74, 222, 128, 0.6); }
}

/* --- Navigation Lock --- */
.timed-nav.locked {
  display: none;
}

.timed-nav.unlocked {
  display: block;
}

/* --- Screen Flash on Completion --- */
.enc-timer-flash {
  position: fixed;
  inset: 0;
  background: rgba(74, 222, 128, 0.12);
  z-index: 999;
  pointer-events: none;
  animation: flash-fade 1.2s ease-out forwards;
}

@keyframes flash-fade {
  0% { opacity: 1; }
  100% { opacity: 0; }
}